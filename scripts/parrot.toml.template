[daemon]
host = "127.0.0.1"
# parrotd standalone 默认端口；CLI 自动起子进程时会通过 PARROTD_PORT
# 覆盖为一个随机端口，所以这个值只在手动运行 `parrotd` 时生效。
port = 9876
auth_token_file = "{USER_DATA_DIR}/parrot/token"

[session]
data_dir = "{USER_DATA_DIR}/parrot/sessions"
max_history_tokens = 100000
keep_recent_turns = 6

[tools]
shell_allowed = false
file_write_allowed = false
web_allowed = true
max_file_size_mb = 10

[tools.sandbox]
working_dir = "."
allowlist = []
denylist = ["rm -rf /", "sudo", "chmod 777"]
require_confirmation = ["git push", "rm"]

# Provider 配置：取消下面整块的注释并改成你要用的 provider。`api_key`
# 支持 `${ENV_VAR}` 形式的占位符，从环境变量读取（推荐，避免 key 入盘）。
# daemon 启动时若 `[[providers]]` 缺失或为空，会落到内置 fallback 模型
# 上（往往不是你想用的），所以**首次使用前请至少配置一个 provider**。
#
# 示例：Anthropic
# [[providers]]
# id = "anthropic"
# api_key = "${ANTHROPIC_API_KEY}"
# default_model = "claude-sonnet-4-6"
# base_url = "https://api.anthropic.com"
# models = ["claude-sonnet-4-6"]
#
# 示例：DeepSeek（Anthropic 兼容协议）
# [[providers]]
# id = "deepseek"
# api_key = "${DEEPSEEK_API_KEY}"
# default_model = "deepseek-chat"
# base_url = "https://api.deepseek.com/anthropic"
# models = ["deepseek-chat", "deepseek-reasoner"]